{% extends "base.html.j2" %}
{% block content %}
<h1>Notes to insert</h1>

{% for line, notes, problem in previews %}
<h4>{{line.source_id}} &mdash; {{line.source_type}}</h4>
<p>{{line.annotated_text}}</p>

{% if problem %}
<p class="text-danger">{{problem}}</p>
{% else %}
<table>
    <thead>
        <tr><th>Ref</th><th>Deck</th><th>Field</th><th>Value</th></tr>
    </thead>
    <tbody>
        {% for note in notes %}
        {% for name, value in note.fields.items() %}
        <tr>
            <td>{% if loop.first %}{{note.ref}}{% endif %}</td>
            <td>{% if loop.first %}{{note.deck}}{% endif %}</td>
            <td>{{name}}</td>
            <td>{{value}}</td>
        </tr>
        {% endfor %}
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endfor %}

<form action="/insert_anki_notes" method="post" enctype="multipart/form-data">
    <div class="row padding-small">
        <button class="btn-success">Insert all</button>
    </div>
</form>
{% endblock content %}
