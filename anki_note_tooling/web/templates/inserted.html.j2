{% extends "base.html.j2" %}
{% block content %}
<table>
    <thead>
        <tr>
            <th>Source ID</th>
            <th>Inserted At</th>
        </tr>
    </thead>
    <tbody>
        {% for row in results %}
        <tr>
            <td>{{row[0]}}</td>
            <td>{{row[1]}}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock content %}